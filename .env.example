# AegisGrid V2 — Environment Variables
# Copy to .env.local and fill only the values you actually use.
# Do not commit real secrets.

# App
NEXT_PUBLIC_APP_NAME=AegisGrid
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Postgres persistence for users, entitlements, credit ledger, and reports)
# Apply schema with: psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=postgresql://user:password@localhost:5432/aegisgrid
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
POSTGRES_DB=aegisgrid
POSTGRES_USER=aegisgrid
POSTGRES_PASSWORD=change-me-local-only

# Auth (token auth wired for server-side gates; OAuth provider wiring planned)
AUTH_SECRET=change-me
# Comma-separated subject-id:token pairs for local/API auth, e.g. alice:strong-random-token
AUTH_USER_TOKENS=
# Bearer token for local admin/operator API access. Do not reuse scanner keys.
AUTH_ADMIN_TOKEN=
# Static dev entitlements, e.g. alice:premium,alice:ai_report.
# Used by default only when DATABASE_URL is not set; set AUTH_STATIC_ENTITLEMENTS_FALLBACK=true for non-production DB-backed local development.
AUTH_USER_ENTITLEMENTS=
AUTH_STATIC_ENTITLEMENTS_FALLBACK=false
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (official stripe-node SDK; checkout/portal/webhook routes wired)
# Webhook processing requires DATABASE_URL schema and fails closed without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_REPORT_PACK=
STRIPE_REPORT_PACK_CREDITS=10

# x402 / USDC (official v2 packages: @x402/next, @x402/evm, @coinbase/x402; /api/x402/report and /api/x402/enrich require DATABASE_URL, wallet, facilitator, and deterministic source-bounded generation)
X402_ENABLED=false
X402_RECEIVING_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=eip155:8453
X402_REPORT_PRICE_USDC=1.00
X402_API_PRICE_USDC=0.05
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# AI reports — provider abstraction
# AI_PROVIDER controls which backend generates situational reports.
# Supported values:
#   none          — AI report generation disabled (default, fail-closed)
#   deterministic — local source-bounded reports without external API calls (safe default)
#   openai        — OpenAI chat completions API (requires OPENAI_API_KEY)
#   deepseek      — DeepSeek API, OpenAI-compatible (requires DEEPSEEK_API_KEY)
#   gemini        — Google Gemini via OpenAI-compatible endpoint (requires GEMINI_API_KEY)
#   hermes        — Hermes-compatible API endpoint (requires HERMES_API_KEY, HERMES_API_URL)
# For openai provider, set OPENAI_BASE_URL to use a custom endpoint (e.g. DeepSeek, local LLM)
AI_PROVIDER=none
AI_MODEL_REPORTS=
AI_MODEL_FAST=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HERMES_API_KEY=
HERMES_API_URL=

# Scanner proxy
# Passive scanner route modules (rdns, whois, subdomains, geoloc, vuln) work without backend config.
# Active scans require an authenticated scanner subject AND target entitlement (verified subject target or admin allowlist), plus SCANNER_URL and SCANNER_KEY.
# SCANNER_USER_TOKENS format: subject-id:token,subject-id-2:token-2. Use strong random tokens; do not reuse SCANNER_KEY.
# SCANNER_ADMIN_TOKEN gates admin allowlist and audit export endpoints for remote operators. Localhost requests are also treated as admin for self-hosted VPS operations.
# SCANNER_ALLOWED_TARGETS is a read-only admin allowlist baseline: comma-separated exact hosts/IPs or wildcard subdomains, e.g. example.com,*.example.com,203.0.113.10.
# SCANNER_VERIFIED_TARGETS is a read-only subject target entitlement baseline: subject-id:example.com,subject-id-2:test.org.
# SCANNER_REQUIRE_VERIFICATION is used by the private Scanner V2 runner; the public route still requires auth + target entitlement.
SCANNER_URL=
SCANNER_KEY=
SCANNER_USER_TOKENS=
SCANNER_ADMIN_TOKEN=
SCANNER_ALLOWED_TARGETS=
SCANNER_VERIFIED_TARGETS=
SCANNER_REQUIRE_VERIFICATION=true
SCANNER_VERIFICATION_SECRET=change-me
SCANNER_TARGETS_DIR=.data/scanner-targets
SCANNER_ADMIN_ALLOWLIST_PATH=.data/scanner-admin-allowlist.json
SCANNER_V2_HOST=127.0.0.1
SCANNER_V2_PORT=4007
SCANNER_V2_ALLOW_NON_LOOPBACK=false
SCANNER_AUDIT_PERSISTENCE=file
SCANNER_AUDIT_LOG_PATH=.data/scanner-audit.jsonl

# Optional public/free APIs and enrichment providers
NASA_FIRMS_MAP_KEY=
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
N2YO_API_KEY=
IPCAMLIVE_API_SECRET=

# Jobs / cache
# REDIS_URL enables the optional shared cache client via ioredis; when unset, cache-store uses in-memory TTL fallback. Job queues/workers are still planned.
REDIS_URL=
CRON_SECRET=

# Feature flags
FEATURE_AI_REPORTS=false
FEATURE_COMMS=false
FEATURE_PREMIUM=false
FEATURE_X402=false
