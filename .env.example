# AegisGrid V2 — Environment Variables
# Copy to .env.local and fill only the values you actually use.
# Do not commit real secrets.

# App
NEXT_PUBLIC_APP_NAME=AegisGrid
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (planned; unused until auth/billing/report persistence is implemented)
DATABASE_URL=postgresql://user:password@localhost:5432/aegisgrid

# Auth (planned)
AUTH_SECRET=change-me
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe (planned)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_REPORT_PACK=

# x402 / USDC (planned)
X402_ENABLED=false
X402_RECEIVING_ADDRESS=
X402_FACILITATOR_URL=
X402_NETWORK=eip155:8453
X402_REPORT_PRICE_USDC=1.00
X402_API_PRICE_USDC=0.05

# AI (planned)
AI_PROVIDER=none
OPENAI_API_KEY=
HERMES_API_KEY=
AI_MODEL_REPORTS=
AI_MODEL_FAST=

# Scanner proxy
# Passive scanner route modules (rdns, whois, subdomains, geoloc, vuln) work without backend config.
# Public active scans still require explicit SCANNER_ALLOWED_TARGETS plus SCANNER_URL and SCANNER_KEY.
# Use comma-separated exact hosts/IPs or wildcard subdomains, e.g. example.com,*.example.com,203.0.113.10.
# SCANNER_REQUIRE_VERIFICATION is used by the private Scanner V2 runner; the public route still requires explicit allowlisting.
SCANNER_URL=
SCANNER_KEY=
SCANNER_ALLOWED_TARGETS=
SCANNER_REQUIRE_VERIFICATION=true
SCANNER_V2_HOST=127.0.0.1
SCANNER_V2_PORT=4007
SCANNER_V2_ALLOW_NON_LOOPBACK=false
SCANNER_AUDIT_PERSISTENCE=file
SCANNER_AUDIT_LOG_PATH=.data/scanner-audit.jsonl

# Optional public/free APIs and enrichment providers
NASA_FIRMS_MAP_KEY=
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
N2YO_API_KEY=
IPCAMLIVE_API_SECRET=

# Jobs / cache (planned)
REDIS_URL=
CRON_SECRET=

# Feature flags
FEATURE_AI_REPORTS=false
FEATURE_COMMS=false
FEATURE_PREMIUM=false
FEATURE_X402=false
